pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy Infrastructure') {
            steps {
                script {
                    echo "Поднимаем базу данных и приложение..."
                    // Останавливаем старые контейнеры, если они есть
                    bat "docker-compose down -v || true"
                    // Запускаем инфраструктуру в фоновом режиме
                    bat "docker-compose up -d"

                    // Даем PostgreSQL время на инициализацию
                    sleep time: 10, unit: 'SECONDS'
                }
            }
        }

        stage('Run Functional Tests') {
            steps {
                script {
                    echo "Запуск функционального тестирования..."
                    // Запускаем pytest внутри запущенного контейнера web
                    bat "docker-compose exec -T web pytest tests/"
                }
            }
        }
    }

    post {
        always {
            echo "Очистка тестовой среды..."
            // Гасим инфраструктуру после прогона тестов
            bat "docker-compose down -v"
        }
    }
}