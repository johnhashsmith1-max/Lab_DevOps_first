pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy Infrastructure') {
            steps {
                script {
                    echo "Поднимаем базу данных и приложение..."

                    // Windows-версия безопасной остановки старых контейнеров
                    bat "docker-compose down -v || exit 0"

                    // Запускаем инфраструктуру в фоновом режиме
                    bat "docker-compose up --build -d"

                    // Даем PostgreSQL время на запуск
                    sleep time: 10, unit: 'SECONDS'
                }
            }
        }

        stage('Run Functional Tests') {
            steps {
                script {
                    echo "Запуск функционального тестирования..."
                    // Прогоняем тесты внутри контейнера FastAPI
                    bat "docker-compose exec -T web pytest tests/"
                }
            }
        }
    }

    post {
        always {
            echo "Очистка тестовой среды..."
            // Безопасная очистка (чтобы ошибка удаления не "красила" пайплайн в красный)
            bat "docker-compose down -v || exit 0"
        }
    }
}