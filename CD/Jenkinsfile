pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy and Test') {
            steps {
                // 1. Запускаем всю архитектуру в фоновом режиме (Vault, Инициализатор, БД, Приложение)
                sh 'docker-compose up -d'

                // 2. Даем сервисам время на запуск (Vault нужно время записать секреты, а БД - подняться)
                sh 'sleep 15'

                // 3. Функциональный тест: дергаем API твоей модели
                // Если база недоступна или пароли из Vault не подтянулись - запрос упадет
                sh '''
                    HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -X POST "http://localhost:8000/predict" \
                    -H "Content-Type: application/json" \
                    -d '{"text": "Test news for CI/CD"}')

                    if [ "$HTTP_STATUS" -eq 200 ]; then
                        echo "Успешно: Модель ответила 200 OK. Секреты получены, БД работает!"
                    else
                        echo "Ошибка: API вернул статус $HTTP_STATUS. Тест провален."
                        exit 1
                    fi
                '''
            }
        }

        stage('Run Functional Tests') {
            steps {
                script {
                    echo "Запуск функционального тестирования..."
                    // Добавили "python -m " перед pytest
                    bat "docker-compose exec -T web python -m pytest tests/"
                }
            }
        }
    }

    post {
        always {
            echo "Очистка тестовой среды..."
            bat "docker-compose down -v || exit 0"
        }
    }
}