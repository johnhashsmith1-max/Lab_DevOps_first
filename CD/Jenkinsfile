pipeline {
    agent any

    stages {
        stage('Deploy Container') {
            steps {
                echo "Запуск контейнера из свежего образа..."
                // Останавливаем и удаляем старый контейнер, если он работал
                bat "docker stop ml_fake_news_container || exit 0"
                bat "docker rm ml_fake_news_container || exit 0"

                // Запускаем контейнер из образа, который мы собрали на этапе CI
                // Флаг -d запускает его в фоновом режиме
                bat "docker run -d -p 8000:8000 -v %WORKSPACE%\\experiments:/app/experiments --name ml_fake_news_container tagirdpo/devops_2026:latest"
            }
        }

        stage('Functional Testing') {
            steps {
                echo "Даем серверу 5 секунд на старт..."
                sleep time: 5, unit: 'SECONDS'

                echo "Запуск автоматических тестов внутри контейнера..."
                // Команда docker exec выполняет команду pytest прямо внутри работающего контейнера
                bat "docker exec ml_fake_news_container pytest"
            }
        }
    }

    post {
        success {
            echo "CD Pipeline успешен! Контейнер запущен и прошел все проверки."
        }
        failure {
            echo "Ошибка CD Pipeline. Тесты провалены или контейнер не запустился."
        }
    }
}