pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy Architecture') {
            steps {
                // Поднимаем инфраструктуру (Приложение, Vault, БД) с принудительной ПЕРЕСБОРКОЙ
                bat 'docker-compose up --build -d'

                // Даем сервисам 15 секунд на инициализацию и получение секретов
                powershell 'Start-Sleep -Seconds 15'
            }
        }

        stage('Run Functional Tests') {
            steps {
                echo 'Запуск асинхронного функционального тестирования (API -> Kafka -> Consumer -> Vault -> DB)'

                powershell '''
                    try {
                        Write-Host "1. Ожидание готовности API (до 15 секунд)..."
                        $apiReady = $false
                        for ($k = 1; $k -le 8; $k++) {
                            try {
                                $check = Invoke-WebRequest -Uri "http://localhost:8000/docs" -Method Get -UseBasicParsing -TimeoutSec 2
                                if ($check.StatusCode -eq 200) {
                                    $apiReady = $true
                                    break
                                }
                            } catch {
                                Start-Sleep -Seconds 2
                            }
                        }

                        if (-not $apiReady) {
                            Write-Host "ОШИБКА: API сервис не запустился на порту 8000! Вывод логов model_app:"
                            docker-compose logs model_app
                            exit 1
                        }

                        Write-Host "API готов. Отправка POST-запроса к API (Producer)..."
                        $response = Invoke-WebRequest -Uri "http://localhost:8000/predict" -Method Post -ContentType "application/json" -Body '{"text": "Test async Kafka news"}' -UseBasicParsing

                        Write-Host "API ответил 200 OK. Сообщение отправлено брокеру Kafka."
                        Write-Host "2. Ожидание обработки Consumer'ом (до 30 секунд)..."

                        $success = $false
                        for ($i = 1; $i -le 15; $i++) {
                            Start-Sleep -Seconds 2
                            $consumerLogs = docker-compose logs consumer_app 2>&1
                            if ($consumerLogs -match "SUCCESS_DB_WRITE") {
                                $success = $true
                                break
                            }
                            Write-Host "Ожидание записи в БД... ($($i * 2) сек)"
                        }

                        Write-Host "--- Логи consumer_app ---"
                        Write-Host $consumerLogs
                        Write-Host "-------------------------"

                        if ($success) {
                            Write-Host "ФУНКЦИОНАЛЬНЫЙ ТЕСТ ПРОЙДЕН УСПЕШНО!"
                            Write-Host "Интеграция Kafka Producer и Consumer работает корректно."
                        } else {
                            Write-Host "Ошибка тестирования: В логах Consumer нет подтверждения SUCCESS_DB_WRITE."
                            exit 1
                        }
                    } catch {
                        Write-Host "Произошла ошибка тестирования: $_"
                        Write-Host "--- Логи всех контейнеров ---"
                        docker-compose logs
                        exit 1
                    }
                '''
            }
        }
    }

    post {
        always {
            echo 'Очистка тестовой среды...'
            // Останавливаем и удаляем контейнеры, даже если тест упал
            bat 'docker-compose down -v || exit 0'
        }
    }
}