pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy Architecture') {
            steps {
                // Поднимаем инфраструктуру (Приложение, Vault, БД)
                bat 'docker-compose up -d'

                // Даем сервисам 15 секунд на инициализацию и получение секретов
                powershell 'Start-Sleep -Seconds 15'
            }
        }

        stage('Run Functional Tests') {
            steps {
                echo 'Запуск асинхронного функционального тестирования (API -> Kafka -> Consumer -> Vault -> DB'

                // Это и есть наш тест инфраструктуры и взаимодействия с хранилищем
                powershell '''
                    try {
                        Write-Host "1. Отправка POST-запроса к API (Producer)..."
                        $response = Invoke-WebRequest -Uri "http://localhost:8000/predict" -Method Post -ContentType "application/json" -Body '{"text": "Test async Kafka news"}' -UseBasicParsing

                        if ($response.StatusCode -eq 200) {
                            Write-Host "API ответил 200 OK. Сообщение успешно передано брокеру Kafka."

                            Write-Host "2. Даем Consumer'у 10 секунд на извлечение секретов из Vault, чтение топика Kafka и запись в БД..."
                            Start-Sleep -Seconds 10

                            Write-Host "3. Проверка логов lab4_consumer_app..."
                            # Считываем логи контейнера
                            $consumerLogs = docker logs lab4_consumer_app 2>&1
                            Write-Host $consumerLogs

                            # Ищем ключевую фразу успешной записи в логах
                            if ($consumerLogs -match "Данные успешно сохранены в БД!") {
                                Write-Host "ФУНКЦИОНАЛЬНЫЙ ТЕСТ ПРОЙДЕН УСПЕШНО!"
                                Write-Host "Интеграция Kafka Producer и Consumer работает корректно."
                            } else {
                                Write-Host "Ошибка тестирования: В логах Consumer нет подтверждения успешной обработки сообщения из Kafka."
                                exit 1
                            }
                        } else {
                            Write-Host "Ошибка: API вернул статус $($response.StatusCode)."
                            exit 1
                        }
                    } catch {
                        Write-Host "Произошла ошибка (сервис недоступен): $_"
                        exit 1
                    }
                '''
            }
        }
    }

    post {
        always {
            echo 'Очистка тестовой среды...'
            // Останавливаем и удаляем контейнеры, даже если тест упал
            bat 'docker-compose down -v || exit 0'
        }
    }
}