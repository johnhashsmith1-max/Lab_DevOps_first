pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy and Test') {
            steps {
                // 1. Запускаем всю архитектуру через обычный cmd Windows
                bat 'docker-compose up -d'

                // 2. Даем сервисам 15 секунд на запуск через PowerShell
                powershell 'Start-Sleep -Seconds 15'

                // 3. Функциональный тест: дергаем API твоей модели через PowerShell
                powershell '''
                    try {
                        # Делаем POST-запрос
                        $response = Invoke-WebRequest -Uri "http://localhost:8000/predict" -Method Post -ContentType "application/json" -Body '{"text": "Test news for CI/CD"}' -UseBasicParsing

                        # Проверяем статус-код
                        if ($response.StatusCode -eq 200) {
                            Write-Host "Успешно: Модель ответила 200 OK. Секреты получены, БД работает!"
                        } else {
                            Write-Host "Ошибка: API вернул статус $($response.StatusCode). Тест провален."
                            exit 1
                        }
                    } catch {
                        Write-Host "Произошла ошибка при обращении к API (возможно, контейнер упал): $_"
                        exit 1
                    }
                '''
            }
        }

        stage('Run Functional Tests') {
            steps {
                script {
                    echo "Запуск функционального тестирования..."
                    bat 'docker exec lab3_model_app python -m pytest tests/'
                }
            }
        }
    }

    post {
        always {
            echo "Очистка тестовой среды..."
            bat "docker-compose down -v || exit 0"
        }
    }
}