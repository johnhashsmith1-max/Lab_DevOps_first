pipeline {
    agent any

    environment {
        // Укажи здесь свой логин от DockerHub
        DOCKERHUB_USER = 'tagirdpo'
        IMAGE_NAME = 'fake-news-api'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                // Скачиваем актуальный код из GitHub
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Сборка Docker-образа..."
                    // Собираем образ с тегом (например, myuser/fake-news-api:1)
                    dockerImage = docker.build("${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    echo "Отправка образа в DockerHub..."
                    // Используем ID учетных данных, которые мы создали в Jenkins
                    docker.withRegistry('', 'DockerHub_acess_key') {
                        dockerImage.push()
                        // Также пушим с тегом latest, чтобы всегда был доступен свежий образ
                        dockerImage.push('latest')
                    }
                }
            }
        }
    }

    post {
        success {
            echo "CI Pipeline успешно завершен! Образ отправлен в DockerHub."
        }
        failure {
            echo "Ошибка при выполнении CI Pipeline. Проверьте логи."
        }
    }
}