pipeline {
    agent any

    environment {
        // Учетные данные DockerHub
        DOCKERHUB_CREDS = credentials('dockerhub_creds')
        // Твой логин и имя образа
        IMAGE_NAME = "твой_логин_dockerhub/fakenews_model"
        IMAGE_TAG = "latest"
    }

    stages {
        stage('Checkout') {
            steps {
                // Скачиваем код из репозитория
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Сборка Docker образа FastAPI..."
                    // Т.к. скрипт запускается из корня workspace, Dockerfile должен быть доступен
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    echo "Авторизация и отправка образа в DockerHub..."
                    sh "echo ${DOCKERHUB_CREDS_PSW} | docker login -u ${DOCKERHUB_CREDS_USR} --password-stdin"
                    sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }
    }
}